# ── Runtime ──────────────────────────────────────────────────────────
# development | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── News sources ─────────────────────────────────────────────────────
# Active publishers, in priority order. A source with no key is skipped.
ENABLED_SOURCES=guardian,nyt

# Guardian Open Platform — free key: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=

# New York Times Article Search API — free key: https://developer.nytimes.com/
# Note: the NYT API returns abstracts and lead paragraphs, not full article
# bodies, so NYT evidence is shorter than Guardian evidence.
# Rate limits are tight (~5 req/min, 500/day); responses are cached.
NYT_API_KEY=

# ── OpenAI ───────────────────────────────────────────────────────────
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Tavily web search (optional) ─────────────────────────────────────
# Supplementary sources when Guardian reporting can't answer a question.
# Leave empty to run Guardian-only: the decision agent then always picks
# GUARDIAN and no web request is ever made. Key: https://tavily.com
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
# Guardian sources at or below this count trigger a web top-up
WEB_SEARCH_THRESHOLD=2

# ── PostgreSQL (relational + pgvector vector store) ─────────────────
# Local development only — production uses Amazon RDS PostgreSQL and injects
# DATABASE_URL from SSM Parameter Store (same variable, no code change).
# Used by docker-compose to provision the database container
POSTGRES_USER=guardian
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=guardian_news
# Used by the backend. Inside docker-compose the host is "postgres";
# for local (non-Docker) development use localhost.
DATABASE_URL=postgresql+asyncpg://guardian:change-me-strong-password@postgres:5432/guardian_news

# ── Redis cache ──────────────────────────────────────────────────────
# Production uses Amazon ElastiCache Redis via the same REDIS_URL, from SSM.
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300

# ── Frontend / CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. NEVER "*" in production.
FRONTEND_URL=http://localhost:3000
EXTRA_CORS_ORIGINS=http://localhost:5173
# Base URL the React build calls (build-time arg for the frontend image).
# Same-origin deployments (one ALB serving both services) should use /api
VITE_API_BASE_URL=http://localhost:8000/api

# ── RAG tuning ───────────────────────────────────────────────────────
RAG_INITIAL_TOP_K=20
RAG_FINAL_TOP_K=6
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
# llm | cohere | none
RERANKER=llm
COHERE_API_KEY=

# ── Scheduled ingestion ──────────────────────────────────────────────
# The backend pulls fresh articles on this interval while it runs, so the
# index stays current without an external cron. Under multiple workers a
# Redis lock ensures only one worker performs each run.
#
# Budget: each section costs one request per publisher, and developer keys
# cap at 500 requests/day. Keep
#   (1440 / INGEST_INTERVAL_MINUTES) * INGEST_SECTIONS_PER_TICK  <  500
# The defaults below are 288/day; a tick refreshes one section and cycles
# through the six, so every section is current within 30 minutes.
#
# PRODUCTION (ECS Fargate): set INGEST_ENABLED=false on the service tasks —
# every replica would otherwise run its own loop. Ingestion instead runs as an
# EventBridge-scheduled Fargate task every 30 minutes. See aws/ECS_PIPELINE.md.
INGEST_ENABLED=true
INGEST_INTERVAL_MINUTES=5
INGEST_SECTIONS_PER_TICK=1
INGEST_START_DELAY_SECONDS=60

# ── Agent ────────────────────────────────────────────────────────────
MAX_AGENT_ITERATIONS=6
GUARDIAN_PAGE_SIZE=20

# ── Answer playback (text-to-speech) ─────────────────────────────────
# Two independent gates: this switch decides whether the feature exists at
# all, and each reader's own preference — held in their browser, off by
# default — decides whether anything is ever spoken. Enabled here costs
# nothing until somebody opts in.
TTS_ENABLED=true
# gpt-4o-mini-tts accepts delivery instructions; the tts-1 family does not,
# and TTS_INSTRUCTIONS is dropped for it automatically.
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
TTS_FORMAT=mp3
TTS_INSTRUCTIONS=Read as a news presenter: measured, neutral, unhurried.
# Ceiling on one answer's audio spend, and the per-request input cap the
# answer is split across.
TTS_MAX_CHARS=8000
TTS_CHUNK_CHARS=3800
# Audio dwarfs the JSON this cache otherwise holds and Redis runs
# allkeys-lru — a long TTL would evict the article entries that keep the
# site up when a publisher is unreachable. Browsers cache the long tail.
TTS_CACHE_TTL_SECONDS=3600

# ── Security ─────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
# Stricter budget for the expensive /api/chat endpoint
CHAT_RATE_LIMIT_PER_MINUTE=10
# Answer playback gets its own budget rather than sharing the chat one: with
# autoplay on, every turn is a chat request *and* an audio request, and on a
# shared bucket that would halve usable chat throughput.
AUDIO_RATE_LIMIT_PER_MINUTE=20
# Optional shared-secret gate: when set, all API requests (except /api/health)
# must send X-API-Key. For private deployments; pair with VITE_API_KEY below.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Sent by the frontend build when the backend API_KEY gate is enabled.
# NOTE: a key bundled into a public SPA is visible to its users — use this
# only for private/internal deployments.
VITE_API_KEY=
# Comma-separated Host header allowlist, e.g. api.mydomain.com (empty = any)
ALLOWED_HOSTS=
# Max request body size in bytes and time-to-first-byte cap in seconds
MAX_BODY_BYTES=65536
REQUEST_TIMEOUT_SECONDS=120
